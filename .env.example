# Transporte hacia el dispositivo: mock | mqtt | http
VITE_TRANSPORT=mock

# Autenticación: mock | http
VITE_AUTH=mock

# Credenciales de prueba del mock (NO son seguridad real: todo lo que empieza con VITE_ termina en el JS público)
VITE_MOCK_EMAIL=demo@starthome.local
VITE_MOCK_PASSWORD=starthome

# Base de los webhooks de n8n (para VITE_AUTH=http / VITE_TRANSPORT=http)
VITE_N8N_URL=https://tu-n8n.example.com/webhook

# Identificador del dispositivo
VITE_DEVICE_ID=casa-01
